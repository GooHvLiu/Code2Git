# ==================== 应用配置 ====================
NODE_ENV=development
APP_PORT=3002
APP_HOST=0.0.0.0
# 本机局域网IP（用于局域网访问，dotenvInit 会自动检测，无需手动填写）
LOCAL_IP=

# ==================== 数据库配置 ====================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_database_name
DB_CONNECTION_LIMIT=10

# ==================== JWT配置 ====================
# JWT 签名密钥（生产环境请更换为随机字符串）
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# ==================== 文件上传配置 ====================
UPLOAD_DIR=./uploads
# 单文件最大大小（字节），默认 10MB
MAX_FILE_SIZE=10485760

# ==================== GitHub 图床配置（可选，不用可留空） ====================
# GitHub Personal Access Token (需要 repo 权限)
GITHUB_TOKEN=
# 仓库所有者（用户名或组织名）
GITHUB_OWNER=
# 仓库名
GITHUB_REPO=
# 分支名
GITHUB_BRANCH=main
# 图床在仓库里的目录前缀
GITHUB_PATH_PREFIX=
# 访问域名（默认 raw.githubusercontent.com，如用 CDN 可替换）
GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com

# ==================== 联表查询字段（业务相关，根据实际表结构配置） ====================
# 联表查询的关联字段名
UNION_KEY=agent
# 联表查询的关联字段值
UNION_VALUE=input_user_id

# ==================== PLC 通讯配置（可选，不用可留空） ====================
# 协议类型：ModbusTcp / S7 / OpcUa
PLC_PROTOCOL=ModbusTcp
# PLC IP 地址
PLC_HOST=127.0.0.1
# PLC 端口（Modbus-TCP默认502；S7:102；OPC-UA:4840）
PLC_PORT=502
# Modbus 从站 ID
PLC_UNIT_ID=1
# 高频轮询间隔（ms），状态/报警类点位
PLC_FAST_INTERVAL=200
# 低频轮询间隔（ms），工艺参数类点位
PLC_SLOW_INTERVAL=1000
# 断线重连等待时间（ms）
PLC_RECONNECT_DELAY=3000
# 是否开启自动轮询采集
PLC_ENABLE_POLL=true
# 是否开启写操作审计追踪（GMP 21CFR Part11）
PLC_ENABLE_WRITE_AUDIT=true
# 写失败重试次数
PLC_MAX_WRITE_RETRY=1
# PLC 操作超时配置（ms）
PLC_TIMEOUT_CONNECT=5000       # 连接超时
PLC_TIMEOUT_READ=5000          # 单点位读取超时
PLC_TIMEOUT_READ_BATCH=8000    # 批量读取超时
PLC_TIMEOUT_WRITE=5000         # 写入超时
PLC_TIMEOUT_GENERAL=10000      # 通用操作超时

# 授权配置（Beehive License） 
# 授权项目ID（必须与 Beehive 管理后台登记的项目ID一致）
LICENSE_PROJECT_ID=nex-sm-v2
# 授权文件路径（.lic 文件）
LICENSE_FILE_PATH=./license/license.lic
# RSA 公钥文件路径
LICENSE_PUBLIC_KEY_PATH=./license/public.pem
# 时间守卫文件路径（防时间回退）
LICENSE_TIME_GUARD_PATH=./license/.timeguard
# 严格模式：true=授权失败返回403，false=只警告不拦截
LICENSE_STRICT_MODE=true
# 授权文件最大大小（字节）
LICENSE_MAX_FILE_SIZE=1048576