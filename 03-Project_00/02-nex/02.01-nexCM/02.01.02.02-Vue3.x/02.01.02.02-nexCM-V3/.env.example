# ==========================================
# 环境变量模板
# ==========================================
# 复制为 .env.development / .env.production 并修改
# 只有以 VITE_ 开头的变量会被打包进客户端代码

# 接口基础路径（开发相对走代理，生产写完整地址）
VITE_BASE_API = '/prod-api/v2'
# 后端代理目标（仅开发）
VITE_PROXY_TARGET = 'http://127.0.0.1:3002'
# 开发端口
VITE_PORT = 8082
# 页面标题
VITE_APP_TITLE = 'nexCM 管理系统'
# WebSocket 开发主机
VITE_WS_HOST = 'localhost:3002'
# 部署子路径（默认根路径 '/'）
# VITE_PUBLIC_PATH = '/'
