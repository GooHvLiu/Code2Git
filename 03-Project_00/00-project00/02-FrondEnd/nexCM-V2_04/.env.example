# ==========================================
# 环境变量模板
# ==========================================
# 复制此文件为 .env.development 或 .env.production 并修改对应值
# 只有以 VUE_APP_ 开头的变量会被 webpack 打包进客户端代码
# 注意：环境变量中不要存放敏感信息（如密钥、密码），会暴露到前端

# ==================== 接口配置 ====================
# 接口基础路径
# 开发环境：相对路径，走 vue.config.js 的 devServer.proxy 代理
# 生产环境：必须写后端完整地址（打包后 proxy 失效），如 http://your-domain.com/api
VUE_APP_BASE_API = '/prod-api/v2'

# 后端代理目标地址（仅开发环境生效，生产环境忽略）
VUE_APP_PROXY_TARGET = 'http://127.0.0.1:3002'

# ==================== 开发服务器 ====================
# 开发服务器端口（仅开发环境生效）
VUE_APP_PORT = 8082

# ==================== 页面配置 ====================
# 页面标题（浏览器标签页显示，也可在 config/system.js 中配置 SYSTEM_NAME）
VUE_APP_TITLE = 'nexCM 管理系统'

# ==================== 部署配置（可选） ====================
# 应用部署的子路径，如部署在 https://domain.com/admin/ 下则填 /admin/
# 默认为 '/'，部署在根路径时不需要修改
# VUE_APP_PUBLIC_PATH = '/'
