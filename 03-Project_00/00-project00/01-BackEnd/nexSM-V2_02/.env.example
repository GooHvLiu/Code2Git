# ==================== 应用配置 ====================
NODE_ENV=development
APP_PORT=3002
APP_HOST=0.0.0.0
# 本机局域网IP（用于局域网访问，dotenvInit 会自动检测，无需手动填写）
LOCAL_IP=

# ==================== 数据库配置 ====================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_database_name
DB_CONNECTION_LIMIT=10

# ==================== JWT配置 ====================
# JWT 签名密钥（生产环境请更换为随机字符串）
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# ==================== 文件上传配置 ====================
UPLOAD_DIR=./uploads
# 单文件最大大小（字节），默认 10MB
MAX_FILE_SIZE=10485760

# ==================== GitHub 图床配置（可选，不用可留空） ====================
# GitHub Personal Access Token (需要 repo 权限)
GITHUB_TOKEN=
# 仓库所有者（用户名或组织名）
GITHUB_OWNER=
# 仓库名
GITHUB_REPO=
# 分支名
GITHUB_BRANCH=main
# 图床在仓库里的目录前缀
GITHUB_PATH_PREFIX=
# 访问域名（默认 raw.githubusercontent.com，如用 CDN 可替换）
GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com

# ==================== 联表查询字段（业务相关，根据实际表结构配置） ====================
# 联表查询的关联字段名
UNION_KEY=agent
# 联表查询的关联字段值
UNION_VALUE=input_user_id
