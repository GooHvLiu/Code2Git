# ============================================
# 服务器配置
# process.env.LISTEN_AREA: 用于设定是否在本地使用还是局域网内使用
# ============================================
PORT=3000
LISTEN_AREA=x.x.x.x
NODE_ENV=development
SERVER_IP=http://${LOCAL_IP}:${PORT}

# ============================================
# 局域网IP
# 自动获取的局域网IP（由 setup-env.js 自动更新）
# ============================================
LOCAL_IP=x.x.x.x

# ============================================
# MongoDB数据库配置
# 加载 .env 文件,所有 .env 文件中的变量都会被加载到 process.env 对象中
# require("dotenv-expand").expand(require("dotenv").config());
# ============================================
MONGODB_DBHOST=${LOCAL_IP}
MONGODB_DBPORT=xxxxx
# MONGODB_DBNAME=myaccounts
# MONGODB_USERCOLLECTION=users
# MONGODB_ACCOUNTSCOLLECTION=accounts
MONGODB_DBNAME=xxxxx
MONGODB_USERCOLLECTION=xxxxx
MONGODB_ACCOUNTSCOLLECTION=xxxxx
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_POOL_SIZE=10
MONGODB_TIMEOUT=3000
EXIT_ON_DB_ERROR=true

# ============================================
# JWT 配置
# JWT_EXPIRES 合法过期时间：s秒 m分 h时 d天
# Bearer 是需要有空格的，非常重要
# ============================================
JWT_SECRET=xxxxx
JWT_REFRESH_SECRET=xxxxx
JWT_EXPIRES=2h
JWT_AUTH_HEADER_KEY=authorization
JWT_AUTH_PREFIX=Bearer 


# ============================================
# API 配置
# ============================================
API_PREFIX=/api

# ============================================
# 文件上传配置
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# ============================================
# CORS 配置
# ============================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]