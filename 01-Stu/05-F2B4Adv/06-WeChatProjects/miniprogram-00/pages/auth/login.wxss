.wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}
.msg { font-size: 32rpx; color: #666; }
.ok { font-size: 40rpx; color: #67c23a; font-weight: bold; }
.sub { font-size: 28rpx; color: #999; margin-top: 20rpx; }
.err { font-size: 32rpx; color: #f56c6c; }
